    },
    {
      "type": "Heading",
      "props": {
        "id": "Heading-eb258632-8059-4075-a690-b493e0d9d506",
        "text": "The story",
        "size": "title",
        "level": "h2",
        "align": "start",
        "layout": {
          "width": "text",
          "space": "m",
          "show": "all",
