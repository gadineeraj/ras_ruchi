    {
      "type": "Heading",
      "props": {
        "id": "Heading-d19dabd6-4630-44f8-93cd-3cb0beff220c",
        "text": "Environment friendly",
        "size": "title",
        "level": "h2",
        "align": "start",
        "layout": {
