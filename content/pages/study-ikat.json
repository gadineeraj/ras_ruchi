    {
      "type": "Text",
      "props": {
        "id": "Text-0f917669-3507-4e43-8bec-4e7ad4ccf1b3",
        "text": "<p>Inspired by the Headgear of the Odissi dancers, which represents the flower - Kadamb. The Headgear is one of the most important and significant jewellery of the Odissi costume. It is a warp based ikkat fabric.</p>",
        "style": "body",
        "align": "start",
        "measure": "normal",
        "layout": {
          "width": "text",
          "space": "s",
          "show": "all",
          "motion": "none"
        }
      }
    },
