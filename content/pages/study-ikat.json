    {
      "type": "Heading",
      "props": {
        "id": "Heading-08821681-daea-45b6-b891-3afcb8f2efcc",
        "text": "Mudra",
        "size": "title",
        "level": "h2",
        "align": "start",
        "layout": {
          "width": "text",
          "space": "m",
