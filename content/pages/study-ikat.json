    {
      "type": "Text",
      "props": {
        "id": "Text-14518179-3fdb-458d-96dd-1b7db0f983ae",
        "text": "<p>The waistband (kamarbandh) is another important jewellery, which sets the costume of odissi different from other classical dance costumes.</p>",
        "style": "body",
        "align": "start",
        "measure": "normal",
        "layout": {
          "width": "text",
          "space": "s",
          "show": "all",
          "motion": "none"
