    {
      "type": "Text",
      "props": {
        "id": "Text-4b8c6338-630a-45eb-81d5-2d15934ecb4e",
        "text": "<p>Sura is a collection of Ajrak motifs inspired by the African craft of masks. Each of the masks communicate a message or emotion. The masks have a story behind them and have symbolic meaning. These masks come in all different colors and have abstract or geometric patterns on them.</p>",
        "style": "body",
        "align": "start",
        "measure": "normal",
        "layout": {
          "width": "text",
          "space": "s",
          "show": "all",
          "motion": "none"
        }
      }
    },
